    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "convex": "1.50.0",
    "convex-helpers": "0.1.135",
    "date-fns": "4.4.0",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
