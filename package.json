{
  "name": "cosmela",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "concurrently -k -n next,convex -c magenta,cyan \"next dev\" \"convex dev --env-file .env.local --typecheck disable\"",
    "dev:next": "next dev",
    "dev:convex": "convex dev --env-file .env.local",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
